# Sunrise Cafe — 環境變數範例
# cp .env.local.example .env.local 後填入實際值
# 完整說明：docs/ENV.md

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- 後台管理 ---
ADMIN_PASSWORD="請換成16字元以上密碼"

# --- LINE 群組 Bot（推播訂位提醒到群組）---
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
LINE_GROUP_ID="C..."

# --- LINE 客人 Bot（Push 訂金請求給客人）---
LINE_CUSTOMER_ACCESS_TOKEN=""

# --- LINE Login（OAuth 登入綁定）---
LINE_LOGIN_CHANNEL_ID=""
LINE_LOGIN_CHANNEL_SECRET=""

# --- Upstash Redis（速率限制，production 建議設定）---
# 未設定時使用每個 serverless isolate 各自的 memory fallback（degraded），不是停用。
# RATE_LIMIT_DISABLED=1 僅限 local/test；production 會拒絕這個設定。
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Sentry（錯誤監控，選填）---
# DSN 未設定時 Sentry 靜默不啟動
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Cron（選填）---
CRON_SECRET=""

# --- CTO Pipeline（選填）---
CTO_OUTCOME_SECRET=""
